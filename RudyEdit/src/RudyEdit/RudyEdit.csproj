<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>rudyedit</AssemblyName><Version>2.0.5</Version>
    <ApplicationIcon>../../assets/rudyedit.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/FEATURES.md" Link="FEATURES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/**" Link="assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/manuals/**" Link="manuals/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../tools/python_debugger.py" Link="tools/python_debugger.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../tests/*.py;../../tests/*.sh;../../tests/*.cmd;../../tests/*.md;../../tests/requirements.txt" Link="tests/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
